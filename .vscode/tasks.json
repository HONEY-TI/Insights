{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Initialize Docker Servers",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/init-tasks",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "runOptions": { "runOn": "folderOpen" },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "focus": false,
                "close": true,
                "showReuseMessage": false,
                "echo": false
            }
        }
    ]
}